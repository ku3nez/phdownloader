[Unit]
Description=phdownloader API
After=network.target

[Service]
User=root
WorkingDirectory=/opt/phdownloader
EnvironmentFile=/opt/phdownloader/.env
ExecStart=/opt/phdownloader/venv/bin/gunicorn -w 2 -b 0.0.0.0:5008 --timeout 600 --graceful-timeout 30 --keep-alive 5 app:app
Restart=always
RestartSec=3
StandardOutput=append:/var/log/phdownloader-api.log
StandardError=append:/var/log/phdownloader-api.log
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=OMP_WAIT_POLICY=PASSIVE

[Install]
WantedBy=multi-user.target
