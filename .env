ENABLE_SAVE_ON_SERVER=FALSE
DEFAULT_VIDEO_QUALITY=720
FILE_EXPIRATION_SECONDS=300
PORT=5008

# ---- Cookie Settings ----
# PornHub and YouTube may require browser cookies to avoid 403 errors.
# Option 1: Use cookies directly from your browser (browser must be closed or not blocking access)
# YT_DLP_COOKIES_BROWSER=chrome
# YT_DLP_COOKIES_BROWSER=firefox

# Option 2: Export cookies to a file using a browser extension (e.g. "Get cookies.txt LOCALLY")
# and place the file as cookies.txt in this directory
YT_DLP_COOKIE_FILE=cookies.txt

# ---- Proxy Settings ----
# If your VPS IP is blocked by PornHub/YouTube (Cloudflare), use a proxy.
# SSH SOCKS5 tunnel: on your LOCAL PC run: ssh -D 1080 -N root@your_vps_ip
# then set: (tunnels traffic through your home IP)
# YT_DLP_PROXY=socks5://127.0.0.1:1080
#
# Or use any HTTP/SOCKS5 proxy:
# YT_DLP_PROXY=http://user:pass@proxy_host:3128
# YT_DLP_PROXY=socks5://user:pass@proxy_host:1080

# ---- Other Settings ----
YT_DLP_JS_RUNTIME=node
